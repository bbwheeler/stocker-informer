# Environment variables for Podman deployment (stocker-informer).
# Fill in GOTOSOCIAL_* before running.

# --- tsx-history gRPC ---
HISTORY_ADDR=localhost:50053

# --- Query settings ---
INFORMER_INTERVAL=1h
EXCHANGE_FILTER=
MAX_RESULTS=5

# --- Weighting (must sum <= 1.0, must be > 0) ---
WEIGHTS_FINANCIALS=0.25
WEIGHTS_SENTIMENT=0.25
WEIGHTS_LEADERSHIP=0.25
WEIGHTS_TYPE_SENTIMENT=0.25

# --- GoToSocial (all required) ---
GOTOSOCIAL_INSTANCE=
GOTOSOCIAL_USER=
GOTOSOCIAL_TOKEN=
