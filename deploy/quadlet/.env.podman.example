# stocker-informer — operator environment template.
# Copy to ~/.config/stocker-informer/.env.podman and chmod 600.
# NEVER commit real credentials.

# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=192.168.1.71:9092,192.168.1.75:9092
KAFKA_TOPIC=stock.summary.available.v1
KAFKA_CONSUMER_GROUP=stocker-informer

# ── Garage / S3 ─────────────────────────────────────────────────────────────
S3_ENDPOINT=http://192.168.1.31:3900
S3_REGION=us-east-1
S3_BUCKET=REPLACE_ME
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_PATH_PREFIX=
S3_TIMEOUT_SECONDS=10

# ── GoToSocial ──────────────────────────────────────────────────────────────
GOTOSOCIAL_INSTANCE=https://wheeli.social
GOTOSOCIAL_USER=bot
GOTOSOCIAL_TOKEN=REPLACE_ME
# global | local | direct
GOTOSOCIAL_AUDIENCE=global
# Required only for direct; full handle or just the username.
# GOTOSOCIAL_RECIPIENT=papa@wheeli.social

# ── Ollama / Cora-9 rewrite ─────────────────────────────────────────────────
# Set to false to publish the original summary unchanged.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://192.168.1.71:11434
OLLAMA_MODEL=gemma4:26b
# Per-rewrite timeout in seconds; must be 1..3600.
OLLAMA_TIMEOUT_SECONDS=120
# 0..2; higher is more creative.
OLLAMA_TEMPERATURE=0.7
# Upper bound on generated tokens; hitting it falls back to the original.
OLLAMA_MAX_TOKENS=1024
# Optional hard cap in characters; 0 = unlimited. Over the cap falls back.
OLLAMA_MAX_OUTPUT_CHARS=0
# Optional persona override; leave unset for the built-in Cora-9 prompt.
# OLLAMA_SYSTEM_PROMPT=
